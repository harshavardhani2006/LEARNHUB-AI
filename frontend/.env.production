# Production env — set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# as environment variables in the Vercel dashboard.
# VITE_API_URL is left empty so api.js falls back to relative /api paths
# (frontend and backend are served from the same Vercel domain).

VITE_API_URL=
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
