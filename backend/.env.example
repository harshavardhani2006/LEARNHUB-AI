# Backend Environment Variables Template
# Copy this file to .env and fill in your real values

# Hugging Face Token for LLM Inference API
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Supabase Connection Settings
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase JWT Secret
# Get from: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# CORS Allowed Origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# FAISS Vector Index Storage Path
FAISS_INDEX_PATH=./faiss_indexes

# Environment: development or production
ENVIRONMENT=development
